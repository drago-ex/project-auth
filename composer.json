{
	"name": "drago-ex/project-auth",
	"description": "Authentication and user access package for the Drago project.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/database": "^3.0 || ^4.0",
		"drago-ex/application": "^3.0 || ^4.0",
		"drago-ex/form": "^2.0 || ^3.0",
		"drago-ex/migration": "^2.3",
		"drago-ex/utils": "^2.0",
		"drago-ex/translator": "^4.0 || ^5.0",
		"drago-ex/project-front": "^2.0",
		"drago-ex/project-backend": "^2.0",
		"nette/caching": "^3.3",
		"nette/http": "^3.0",
		"nette/mail": "^4.0",
		"nette/security": "^3.2"
	},
	"suggest": {
		"drago-ex/permission": "Enables generation of the authentication permission provider."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^2.0"
	},
	"bin": [
		"bin/create-user"
	],
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app": "app",
					"resources/assets": "assets"
				}
			},
			"migration-priority": 10
		},
		"drago-permission": "permission.php",
		"drago-translator": {
			"translation": "app/Presentation/Sign/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
