{
	"name": "drago-ex/project-auth",
	"type": "drago-project-resource",
	"description": "Authentication and user access package for the Drago project.",
	"license": ["MIT"],
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/database": "^2.0",
		"drago-ex/application": "^1.0",
		"drago-ex/form": "^1.0",
		"drago-ex/utils": "^1.0",
		"drago-ex/translator": "^2.0",
		"drago-ex/project-front": "^1.0",
		"drago-ex/project-backend": "^1.0",
		"nette/mail": "^4.0"
	},
	"extra": {
		"drago-project": {
			"priority": 10,
			"install": {
				"copy": {
					"resources/app": "app",
					"resources/assets": "assets"
				}
			},
			"commands": {
				"create:auth-permission": "php vendor/bin/create-auth-permission",
				"db:migrate-auth": "php vendor/bin/migration db:migrate vendor/drago-ex/project-auth/migrations"
			}
		}
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^1.2.9",
		"drago-ex/project-installer": "@dev"
	},
	"bin": [
		"bin/create-user",
		"bin/create-auth-permission"
	],
	"scripts": {
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
