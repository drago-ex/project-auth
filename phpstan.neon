includes:
	- vendor/phpstan/phpstan-nette/extension.neon
	- vendor/drago-ex/database/extension.neon

parameters:
	level: 8
	paths:
		- resources/app
		- tests

	# resources of the dependencies, installed by drago-install --dev
	scanDirectories:
		- .dev-resource
	excludePaths:
		analyseAndScan:
			- tests/tmp (?)
			- tests/*/temp/* (?)
			- tests/*/*/temp/* (?)
