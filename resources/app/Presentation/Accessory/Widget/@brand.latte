{* The brand of the layouts: the name of the website from the settings; without them (a presenter without
   SettingsRequire, or no "website" row) the default name. Installed over the default brand of project-auth. *}
{define brand-logo}
	{* the logo of Netis: a white N in a blue circle, drawn also in www/favicon.svg *}
	<svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
		<circle cx="14" cy="14" r="14" fill="#048ffa"/>
		<path d="M10.25 18.5V9.5l7.5 9V9.5" fill="none" stroke="#fff" stroke-width="2"/>
	</svg>
{/define}

{define brand}
	{if isset($settings) && $settings->has('website')}{$settings->get('website')}{else}Project{/if}
{/define}
