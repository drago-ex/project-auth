{layout '@email.latte'}
{varType string $link}

{block heading}{_'Someone tried to create an account'}{/block}

{block text}{_'An account with this email address already exists. If it was you, sign in with your password, or reset it if you have forgotten it.'}{/block}

{block button}<a href="{$link}" style="color: #ffffff; text-decoration: none;">{_'Reset password'}</a>{/block}

{block footer}{_'If it was not you, you can ignore and delete this email. Nothing has changed in your account.'}{/block}
