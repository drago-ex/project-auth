{layout '@email.latte'}
{varType string $link}

{block heading}{_'Confirm your new email address'}{/block}

{block text}{_'Confirm that you want to use this address for your account. The link is valid for 1 hour.'}{/block}

{block button}<a href="{$link}" style="color: #ffffff; text-decoration: none;">{_'Confirm email address'}</a>{/block}

{block footer}{_'If you did not request this change, you can ignore and delete this email.'}{/block}
