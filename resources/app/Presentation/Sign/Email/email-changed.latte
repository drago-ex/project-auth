{layout '@email.latte'}
{varType string $newEmail}
{varType string $link}

{block heading}{_'Your email address has been changed'}{/block}

{block text}{_'The email address of your account has been changed to %s. If you did not make this change, reset your password right away.', $newEmail}{/block}

{block button}<a href="{$link}" style="color: #ffffff; text-decoration: none;">{_'Reset password'}</a>{/block}
