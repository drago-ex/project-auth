{templateType App\Presentation\Sign\SignTemplate}
{varType Drago\Application\UI\Flashes[] $flashes}
{import '../Accessory/Widget/@lang-switch.latte'}

<!DOCTYPE html>
<html lang="{$lang}" data-bs-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<meta name="robots" content="noindex, nofollow">
	<title n:snippet="title">{ifset title}{include title|stripHtml|firstUpper} &bull; {/ifset}{include brand|stripHtml}</title>

	{asset 'sign-in.js'}
</head>

<body class="d-grid text-body bg-body-tertiary">

<div class="sign-in-page mx-auto d-flex flex-column justify-content-center">
	<div class="d-flex align-items-center justify-content-between mb-3 ms-2">
		<div class="d-flex align-items-center gap-2 text-body-secondary">
			<i class="fa-solid fa-cube fs-5 text-primary" aria-hidden="true"></i>
			<h1 n:block="brand" class="fs-5 fw-semibold mb-1">Project</h1>
		</div>

		{include '../Accessory/Widget/@theme-switch.latte',
			class: 'd-inline-flex align-items-center justify-content-center gap-2 flex-shrink-0 py-1 px-2 text-secondary',
			icon: true
		}
	</div>

	<div class="sign-in-shell w-100 bg-body shadow-sm rounded-3 overflow-hidden">
		<aside class="sign-in-visual d-none d-lg-flex align-items-center justify-content-center text-primary bg-body-secondary" aria-hidden="true">
			<i class="fa-solid fa-shield-halved fa-7x"></i>
		</aside>

		<main class="sign-in-panel bg-body" n:snippet="content">
			<div class="sign-in-toolbar w-100 mx-auto d-flex align-items-center justify-content-end">
				<div class="d-flex align-items-center gap-2">
					{include lang-switch, lang: 'cs', name: 'Czech', class: 'sign-in-language text-body'}
					<span class="text-secondary" aria-hidden="true">&#124;</span>
					{include lang-switch, lang: 'en', name: 'English', class: 'sign-in-language text-body'}
				</div>
			</div>

			<div class="sign-in-panel-inner w-100 mx-auto">
				<header class="mb-4">
					<h1 class="m-0 fs-3 fw-semibold">{include title}</h1>
					{ifset subtitle}
						<p class="mt-2 mb-0 text-body-secondary">{include subtitle}</p>
					{/ifset}
				</header>

				{snippet message}
					{include '../Accessory/Widget/@toast.latte', messages: $flashes}
				{/snippet}

				{include content}
			</div>
		</main>
	</div>

</div>

<footer class="px-3 pb-3 text-center text-body-secondary">
	<p class="m-0">&copy; {=date('Y')} {include brand|stripHtml}</p>
</footer>

</body>
</html>
