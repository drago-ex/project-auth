{templateType App\Presentation\Sign\SignTemplate}
{varType Drago\Application\UI\Flashes[] $flashes}
{import '../Accessory/Widget/@lang-switch.latte'}
{import '../Accessory/Widget/@brand.latte'}

<!DOCTYPE html>
<html lang="{$lang}" data-bs-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="icon" href="{$basePath}/favicon.svg" type="image/svg+xml">
	{* the remembered theme (without one the theme of the system) before the page is drawn, so a dark page does not
	   flash light until the ThemeSwitcher script runs *}
	<script>try { let theme = localStorage.getItem('bootstrap-theme') || 'auto'; if (theme === 'auto') { theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; } if (theme === 'light' || theme === 'dark') { document.documentElement.setAttribute('data-bs-theme', theme); } } catch (e) { }</script>
	<meta name="robots" content="noindex, nofollow">
	<title n:snippet="title">{ifset title}{include title|stripHtml|firstUpper} &bull; {/ifset}{include brand|stripHtml}</title>

	{asset 'sign-in.js'}
</head>

{* the page of the compostrap module auth: the brand and the switches above a box with a visual, a footer under it.
   The texts of the password strength meter are translated here, the script reads them from the body *}
<body class="auth-page" data-strength-min-length="{App\Presentation\Sign\PasswordPolicy::MinLength}"
	data-strength-weak="{_'Weak'}" data-strength-fair="{_'Fair'}" data-strength-good="{_'Good'}" data-strength-strong="{_'Strong'}">

<div class="auth">
	<div class="auth-top">
		<a class="auth-brand" n:href=":Front:Home:">
			{include brand-logo}
			<span>{include brand}</span>
		</a>

		<div class="auth-actions">
			<button type="button" class="btn btn-text btn-icon" aria-label="{_'Toggle theme'}" data-tooltip="left"
				data-theme-switcher data-theme-light-icon="bi bi-sun" data-theme-dark-icon="bi bi-moon">
				<i data-theme-switcher-icon class="bi bi-moon" aria-hidden="true"></i>
			</button>

			{* language: an icon with the code of the current language, the languages in the dropdown *}
			<div class="dropdown">
				<button type="button" class="btn btn-text" data-bs-toggle="dropdown" aria-expanded="false">
					<i class="bi bi-translate me-1" aria-hidden="true"></i><span class="visually-hidden">{_'Language'}: </span>{$lang|upper}
				</button>
				<ul class="dropdown-menu dropdown-menu-end">
					<li><h6 class="dropdown-header">{_'Language'}</h6></li>
					{include lang-switch-item, lang: 'cs', name: 'Czech', current: $lang}
					{include lang-switch-item, lang: 'en', name: 'English', current: $lang}
				</ul>
			</div>
		</div>
	</div>

	<div class="auth-card auth-card-split">
		<aside class="auth-visual" aria-hidden="true">
			<i class="bi bi-shield-lock"></i>
		</aside>

		<main class="auth-body" n:snippet="content">
			<header class="auth-header">
				<h1 class="auth-title">{include title}</h1>
				{ifset subtitle}
					<p class="auth-subtitle">{include subtitle}</p>
				{/ifset}
			</header>

			{snippet message}
				{include '../Accessory/Widget/@toast.latte', flashes: $flashes}
			{/snippet}

			{include content}
		</main>
	</div>

	<footer class="auth-footer">&copy; {=date('Y')} {include brand|stripHtml}</footer>
</div>

</body>
</html>
