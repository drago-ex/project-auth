{block title}{_'Create account'}{/block}
{block subtitle}{_'Enter your details to create a new account.'}{/block}

{block content}
	{embed '../Accessory/Widget/@form.latte', name: 'signUp', class: 'ajax', najaHistory: 'replace'}
		{import '../Accessory/Widget/@form-password.latte'}
		{block form}
			{include input, name: 'username'}
			{include input, name: 'email'}
			{* a new password shows its strength while it is typed (the module strength of compostrap) *}
			<div class="col-12 form-error">
				{label password, class => 'form-label fw-semibold' /}
				<div class="password-toggle">
					{input password, class => 'form-control', aria-describedby => 'password-strength'}
					<button type="button" class="password-toggle-btn" data-password-toggle aria-label="{_'Show password'}" aria-pressed="false"></button>
				</div>
				<div class="strength-bar" data-bs-strength></div>
				<span class="strength-text" id="password-strength" aria-live="polite"></span>
			</div>
			{include password-toggle, name: 'verify'}
			<div class="col-12 d-grid">
				{include submit, name: 'send'}
			</div>
		{/block}
	{/embed}

	<div class="auth-links">
		<a n:href="in" class="ajax" data-link-disable>{_'Back to sign in'}</a>
		<a n:href="recovery" class="ajax" data-link-disable>{_'Forgot your password?'}</a>
	</div>
{/block}
