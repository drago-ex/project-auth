parameters:
	# Sender of the account emails; use an address of your domain, otherwise they end up in spam.
	authMailFrom: no-reply@example.com

	# New accounts must confirm their email address by a link before they can sign in,
	# and a changed email address applies only after it is confirmed.
	authRequireEmailVerification: true


mail:
	smtp: true
	host: localhost
	port: 25
	username: ''
	password: ''
	encryption: null


security:
	authentication:
		expiration: 14 days


routing:
	routes:
		'[<lang=cs cs|en>/]sign/<action>/': Sign:default


services:
	- App\Presentation\Sign\Recovery\SessionService
	- App\Presentation\Sign\RateLimiter
	- App\Presentation\Sign\SignInLimiter
	- App\Presentation\Sign\Recovery\RecoveryLimiter
	- App\Presentation\Sign\Email\EmailSender(from: %authMailFrom%)
	- App\Presentation\Sign\Verification\VerificationService(enabled: %authRequireEmailVerification%)
	- App\Model\User\UserAuthenticator(requireVerification: %authRequireEmailVerification%)
