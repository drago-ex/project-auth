parameters:
	# Sender of the sign-up and password recovery emails; use an address of your domain, otherwise they end up in spam.
	authMailFrom: no-reply@example.com


mail:
	smtp: true
	host: localhost
	port: 25
	username: ''
	password: ''
	encryption: null


security:
	authentication:
		expiration: 14 days


routing:
	routes:
		'[<lang=cs cs|en>/]sign/<action>/': Sign:default


services:
	- App\Presentation\Sign\Recovery\SessionService
	- App\Presentation\Sign\RateLimiter
	- App\Presentation\Sign\SignInLimiter
	- App\Presentation\Sign\Recovery\RecoveryLimiter
	- App\Presentation\Sign\Recovery\EmailService(from: %authMailFrom%)
	- App\Presentation\Sign\Email\SignUpEmailService(from: %authMailFrom%)
	- App\Model\User\UserAuthenticator
