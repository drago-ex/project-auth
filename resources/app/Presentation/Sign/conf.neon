parameters:
	mail:
		host: localhost
		port: 25
		username: ''
		password: ''
		encryption: null


mail:
	smtp: true
	host: %mail.host%
	port: %mail.port%
	username: %mail.username%
	password: %mail.password%
	encryption: %mail.encryption%


security:
	authentication:
		expiration: 14 days


routing:
    routes:
        '[<lang=cs cs|en>/]sign/<action>/': Sign:default


services:
	- App\Presentation\Sign\Recovery\SessionService
	- App\Presentation\Sign\Recovery\EmailService
	- App\Model\User\UserAuthenticator
