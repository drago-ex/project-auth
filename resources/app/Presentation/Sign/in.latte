{block title}{_'Sign in to your account'}{/block}
{block subtitle}{_'Enter your email and password to continue.'}{/block}

{block content}
	{if !$user->loggedIn}
		{embed '../Accessory/Widget/@form.latte', name: 'signIn', najaHistory: 'replace'}
			{import '../Accessory/Widget/@form-password.latte'}
			{block form}
				{include input, name: 'email'}
				{include password-toggle, name: 'password'}
				<div class="col-12 d-grid">
					{include submit, name: 'send'}
				</div>
			{/block}
		{/embed}

		<div class="auth-links">
			<a n:href="up" class="ajax" data-link-disable>{_'Create account'}</a>
			<a n:href="recovery" class="ajax" data-link-disable>{_'Forgot your password?'}</a>
			<a n:if="$verificationEnabled && $notConfirmed" n:href="verification" class="ajax" data-link-disable>{_'Send the confirmation email again'}</a>
		</div>

	{else}
		<p>{_'You are already logged in. You can continue to the administration or log out and switch accounts.'}</p>
		<div class="d-grid">
			<a n:href=":Backend:Admin:" class="btn btn-primary">{_'Administration'}</a>
		</div>
		<div class="auth-links">
			<a n:href="out" class="ajax" data-link-disable>{_'Sign out'}</a>
		</div>
	{/if}
{/block}
