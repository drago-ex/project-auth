{layout '../Email/@email.latte'}
{varType string $token}

{block heading}{_'Forgot your password?'}{/block}

{block text}{_'To reset your password, enter the code you received in this email into the form. The code is valid for 15 minutes.'}{/block}

{block button}<span style="color: #ffffff; font-size: 24px; line-height: 28px; letter-spacing: 5px;">{$token}</span>{/block}

{block footer}{_'If you do not want to change your password or didn’t request a reset, you can ignore and delete this email.'}{/block}
