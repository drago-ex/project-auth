{varType App\Presentation\Sign\Recovery\Token $signRecoveryToken}

{block title}{_'Password recovery'}{/block}
{block subtitle}{_'Follow the steps to restore access to your account.'}{/block}

{block content}
	{if !$signRecoveryToken->hasToken}
		{embed '../Accessory/Widget/@form.latte', name: 'signRecoveryRequest', class: 'ajax', najaHistory: 'off'}
			{block form}
				{include input, name: 'email'}
				<div class="col-12 d-grid gap-1">
					{include submit, name: 'send'}
				</div>
			{/block}
		{/embed}

		<p class="mt-2 mb-0 text-end">
			<a n:href="in" class="btn btn-link p-0 sign-in-link ajax" data-link-disable>{_'Back to sign in'}</a>
		</p>

	{elseif !$signRecoveryToken->isTokenChecked}
		{embed '../Accessory/Widget/@form.latte', name: 'signRecoveryCheckToken', class: 'ajax', najaHistory: 'off'}
			{block form}
				{include input, name: 'token', class: 'otp-code text-center font-monospace fw-semibold'}
				<div class="col-12 d-grid gap-1">
					{include submit, name: 'send'}
					<p class="mt-2">{_'If this address is registered, we have sent a code to it:'}</p>
					<div class="d-flex align-items-center justify-content-between gap-3 rounded px-3 py-2 mb-3 bg-body-tertiary">
						<span class="text-break">{$signRecoveryToken->email}</span>
						<a n:href="changeRecoveryEmail!" class="btn btn-link p-0 sign-in-link ajax flex-shrink-0" data-link-disable>{_'Change'}</a>
					</div>
				</div>
			{/block}
		{/embed}

		<div class="mt-2 text-end">
			<p class="m-0">
				<a n:href="resendRecovery!" class="btn btn-link p-0 sign-in-link ajax" data-link-disable>{_'Send a new code'}</a>
			</p>
			<p class="m-0">
				<a n:href="in" class="btn btn-link p-0 sign-in-link ajax" data-link-disable>{_'Back to sign in'}</a>
			</p>
		</div>

	{else}
		{embed '../Accessory/Widget/@form.latte', name: 'signRecoveryChangePassword', class: 'ajax', najaHistory: 'off'}
			{import '../Accessory/Widget/@form-password.latte'}
			{block form}
				{include password-toggle, name: 'password'}
				{include password-toggle, name: 'verify'}
				<div class="col-12 d-grid gap-1">
					{include submit, name: 'send'}
				</div>
			{/block}
		{/embed}

		<p class="mt-2 mb-0 text-end">
			<a n:href="in" class="btn btn-link p-0 sign-in-link ajax" data-link-disable>{_'Back to sign in'}</a>
		</p>

	{/if}
{/block}
