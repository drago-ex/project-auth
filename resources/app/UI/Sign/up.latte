{block title}{_'Registration'}{/block}
{block subtitle}{_'Create an account to get started.'}{/block}

{block content}
	{embed '../../Core/Widget/@form.latte', name: 'signUp', class: 'ajax', najaHistory: 'replace'}
		{import '../../Core/Widget/@form-password.latte'}
		{block form}
			{include input, name: 'username'}
			{include input, name: 'email'}
			{include password-toggle, name: 'password'}
			{include password-toggle, name: 'verify'}
			<div class="col-12 d-grid gap-1">
				{include submit, name: 'send'}
			</div>
		{/block}
	{/embed}

	<p class="mt-4 mb-0">
		<a n:href="in" class="btn btn-link p-0 text-start ajax" data-link-disable>{_'Back to sign in'}</a>
	</p>
{/block}
