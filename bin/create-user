#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Model\User\UserEntity;
use Dibi\Connection;
use Dibi\UniqueConstraintViolationException;
use Nette\Security\Passwords;
use Nette\Utils\Random;
use Nette\Utils\Validators;

$green = "\033[32m";
$red = "\033[31m";
$reset = "\033[0m";

if ($argc !== 4) {
	echo <<<USAGE
		Add new user to database.

		Usage: create-user <username> <email> <password>

		USAGE;
	exit(1);
}

[, $username, $email, $password] = $argv;

$root = getcwd();

$autoload = $root . '/vendor/autoload.php';
if (!is_file($autoload)) {
	fwrite(STDERR, "{$red}ERROR: Composer autoload not found. Run composer install.{$reset}\n");
	exit(1);
}
require $autoload;

$bootstrapFile = $root . '/app/Bootstrap.php';
if (!is_file($bootstrapFile)) {
	fwrite(STDERR, "{$red}ERROR: Project Bootstrap not found at app/Bootstrap.php.{$reset}\n");
	exit(1);
}
require $bootstrapFile;

if (!Validators::isEmail($email)) {
	fwrite(STDERR, "{$red}ERROR: '{$email}' is not a valid email address.{$reset}\n");
	exit(1);
}

$passwordError = App\Presentation\Sign\PasswordPolicy::validate($password);
if ($passwordError !== null) {
	fwrite(STDERR, "{$red}ERROR: {$passwordError}{$reset}\n");
	exit(1);
}

$bootstrap = new \App\Bootstrap;
$container = $bootstrap->bootWebApplication();

$model = $container->getByType(Connection::class);
\assert($model instanceof Connection);

$hash = $container->getByType(Passwords::class);
\assert($hash instanceof Passwords);

try {
	$model->insert(UserEntity::Table, [
		UserEntity::ColumnUsername => $username,
		UserEntity::ColumnEmail => $email,
		UserEntity::ColumnPassword => $hash->hash($password),
		UserEntity::ColumnToken => Random::generate(32),
		UserEntity::ColumnVerifiedAt => new DateTimeImmutable,
	])->execute();

	echo "{$green}OK User '$username' was created successfully.{$reset}\n";

} catch (UniqueConstraintViolationException) {
	echo "{$red}ERROR: duplicate email.{$reset}\n";
	exit(1);
}
